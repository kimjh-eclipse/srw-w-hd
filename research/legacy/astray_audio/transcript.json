[
  {
    "start": 4.91,
    "end": 7.91,
    "text": "地球に降りんの久しぶりだなぁ"
  },
  {
    "start": 7.91,
    "end": 9.91,
    "text": "いっぱい買い物すんだぁ"
  },
  {
    "start": 10.91,
    "end": 12.91,
    "text": "地球の重力は苦手です"
  },
  {
    "start": 12.91,
    "end": 14.91,
    "text": "体型に悪いものね"
  },
  {
    "start": 15.91,
    "end": 16.91,
    "text": "プロフェッサー"
  },
  {
    "start": 17.91,
    "end": 18.91,
    "text": "あった2日良いですか"
  },
  {
    "start": 19.91,
    "end": 21.91,
    "text": "なんとかしてくださいよその格好"
  },
  {
    "start": 22.91,
    "end": 47.34,
    "text": "ん?"
  },
  {
    "start": 47.34,
    "end": 50.34,
    "text": "どうせそんなの壊れても決まってんだろう"
  },
  {
    "start": 50.34,
    "end": 52.34,
    "text": "現行のモビルスーツが落とした分には"
  },
  {
    "start": 52.34,
    "end": 54.34,
    "text": "400万アウトデーラックタグ"
  },
  {
    "start": 54.34,
    "end": 57.34,
    "text": "続きまして本日の目玉"
  },
  {
    "start": 57.34,
    "end": 59.34,
    "text": "ザフト軍の特殊馬風のトーブです"
  },
  {
    "start": 60.34,
    "end": 61.34,
    "text": "特殊ステルス装甲"
  },
  {
    "start": 61.34,
    "end": 62.34,
    "text": "モノアイの代わりに"
  },
  {
    "start": 62.34,
    "end": 64.34,
    "text": "3次元局面センサーを装備"
  },
  {
    "start": 64.34,
    "end": 68.34,
    "text": "側面には強化復興体育センサーまでついています"
  },
  {
    "start": 68.34,
    "end": 70.34,
    "text": "さらにさらに"
  },
  {
    "start": 70.34,
    "end": 73.34,
    "text": "トーブ武装にはビームサーベルまであるという豪華さ"
  },
  {
    "start": 73.34,
    "end": 76.34,
    "text": "ついにザフトのビーム兵器を搭載したんだ"
  },
  {
    "start": 77.34,
    "end": 78.34,
    "text": "欲しい"
  },
  {
    "start": 78.34,
    "end": 81.34,
    "text": "ビーム兵器ならベッドフレームにもついてるじゃな"
  },
  {
    "start": 81.34,
    "end": 83.34,
    "text": "ザフト製の所がいいんじゃないか"
  },
  {
    "start": 83.34,
    "end": 86.34,
    "text": "違う技術使ったのかもしんないだろうが"
  },
  {
    "start": 86.34,
    "end": 89.34,
    "text": "ジャンカーとしてそんなお宝放っておけるかよ"
  },
  {
    "start": 89.34,
    "end": 90.34,
    "text": "欲しい"
  },
  {
    "start": 90.34,
    "end": 92.34,
    "text": "100万アウト"
  },
  {
    "start": 92.34,
    "end": 93.34,
    "text": "いや100充満だ"
  },
  {
    "start": 94.34,
    "end": 96.34,
    "text": "あなたはもう止められないわ"
  },
  {
    "start": 97.34,
    "end": 98.34,
    "text": "まったく"
  },
  {
    "start": 98.34,
    "end": 100.34,
    "text": "ナチュラルとは興味深い"
  },
  {
    "start": 102.81,
    "end": 104.81,
    "text": "バクーの頭のパワーラインを"
  },
  {
    "start": 104.81,
    "end": 107.81,
    "text": "レッドのパワーラインにつないでる人は"
  },
  {
    "start": 111.6,
    "end": 112.6,
    "text": "うげー"
  },
  {
    "start": 112.6,
    "end": 113.6,
    "text": "危ないじゃない"
  },
  {
    "start": 113.6,
    "end": 114.6,
    "text": "早く見なさいよ"
  },
  {
    "start": 114.6,
    "end": 116.6,
    "text": "はじい"
  },
  {
    "start": 116.6,
    "end": 117.6,
    "text": "ビームつくれ"
  },
  {
    "start": 122.98,
    "end": 123.98,
    "text": "なんだこのデータは"
  },
  {
    "start": 123.98,
    "end": 125.98,
    "text": "プロテクトがかかってやがる"
  },
  {
    "start": 125.98,
    "end": 128.98,
    "text": "俺にかかればちょーらいちょーらい"
  },
  {
    "start": 128.98,
    "end": 130.98,
    "text": "プロテクト"
  },
  {
    "start": 131.98,
    "end": 133.98,
    "text": "おじさん見たことない機体だな"
  },
  {
    "start": 133.98,
    "end": 135.98,
    "text": "やばいデータじゃんこれ"
  },
  {
    "start": 135.98,
    "end": 137.98,
    "text": "かかわりにならない方がいいでしょ"
  },
  {
    "start": 137.98,
    "end": 139.98,
    "text": "廃棄すべきです"
  },
  {
    "start": 139.98,
    "end": 141.98,
    "text": "じゃあその前にコーピングね"
  },
  {
    "start": 141.98,
    "end": 142.98,
    "text": "そうだね"
  },
  {
    "start": 142.98,
    "end": 143.98,
    "text": "了解"
  },
  {
    "start": 143.98,
    "end": 146.98,
    "text": "なぜ私の話を聞いてくれないんですか"
  }
]