{"start": 150.0, "end": 152.0, "text": "\u30c1\u30a7\u30ad\u30fc\u3059\u308b\u98db\u884c\u53f0\u3042\u308a!"}
{"start": 152.0, "end": 155.0, "text": "\u3042\u3089\u3001\u3082\u3046\u6765\u305f\u307f\u305f\u3044\u306d"}
{"start": 155.0, "end": 184.3, "text": "\u5fc3\u914d\u3059\u308b\u306a"}
{"start": 184.3, "end": 187.3, "text": "\u4ffa\u306f\u30b8\u30e3\u30f3\u30af\u3084\u306a\u3001\u4eba\u6bba\u3057\u306f\u3057\u306a\u3044"}
{"start": 187.3, "end": 189.3, "text": "\u30ab\u30c3\u30b3\u3064\u3051\u3066\u308b\u5834\u5408\u3058\u3083\u306a\u3044\u305e!"}
{"start": 189.3, "end": 190.3, "text": "\u306a\u3041!"}
{"start": 190.3, "end": 192.3, "text": "\u6575\u306e\u5897\u63f4\u3092\u30ad\u30e3\u30c3\u30c1!\u8ddd\u96e2\u767a\u751f!"}
{"start": 192.3, "end": 195.3, "text": "\u3046\u308f\u3041!\u56e3\u4f53\u3067\u304d\u3084\u304c\u3063\u305f!"}
{"start": 195.3, "end": 197.3, "text": "\u3068\u306b\u304b\u304f\u9003\u3052\u308b\u305e!"}
{"start": 197.3, "end": 198.3, "text": "\u30ed\u30bc\u30b9\u3055\u3093\u3001\u7af9\u306b\u5206\u304b\u308c\u3088\u3046!"}
{"start": 198.3, "end": 200.3, "text": "\u3088\u3063\u304b\u3044\u3001\u7121\u8336\u3057\u305f\u30c0\u30e1\u3088"}
{"start": 200.3, "end": 203.3, "text": "\u304a\u5b9d\u3082\u306a\u3044\u306e\u306b\u7121\u8336\u306a\u3093\u304c\u3059\u308b\u304b\u3089\u3088!"}
{"start": 216.70999999999998, "end": 218.70999999999998, "text": "\u3053\u3063\u3061\u306e\u65b9\u304c\u5c0f\u56de\u308a\u304c\u52b9\u304f\u3093\u3067\u306d!"}
{"start": 219.70999999999998, "end": 224.01999999999998, "text": "\u30d3\u30fc\u30e0\u3060!"}
{"start": 224.01999999999998, "end": 226.01999999999998, "text": "\u3042\u3093\u306a\u30d3\u30fc\u30e0\u30d5\u30a9\u30fc\u30de\u30fc\u3067\u5b9f\u7528\u5316\u3057\u305f\u6a5f\u4f53\u304c"}
{"start": 226.01999999999998, "end": 228.01999999999998, "text": "\u30b6\u30d5\u30c8\u306b\u3042\u3063\u305f\u306e\u304b?"}
{"start": 228.01999999999998, "end": 230.01999999999998, "text": "\u3067\u3082\u307e\u3060\u3067\u304b\u3044\u306a"}
{"start": 230.01999999999998, "end": 231.01999999999998, "text": "\u51b7\u5374\u88c5\u7f6e\u3082\u3067\u304b\u3044"}
{"start": 231.01999999999998, "end": 233.01999999999998, "text": "\u306a\u3093\u3067\u30a8\u30f3\u30c8\u30ed\u30d4\u30fc\u5236\u5fa1\u306b\u3057\u306a\u3044\u306e?"}
{"start": 233.01999999999998, "end": 235.01999999999998, "text": "\u3042\u308c\u306f\u4fe1\u983c\u6027\u304c\u4f4e\u3044"}
{"start": 235.01999999999998, "end": 236.01999999999998, "text": "\u8d85\u30d4\u30eb\u30c1\u30a7\u52b9\u679c\u304c"}
{"start": 236.01999999999998, "end": 237.01999999999998, "text": "\u7121\u99c4\u306b\u30cf\u30a4\u30d6\u30ea\u30c3\u30c9\u30b7\u30b9\u30c6\u30e0\u3092"}
{"start": 237.01999999999998, "end": 238.01999999999998, "text": "\u30b2\u30fc\u30e0\u3057\u3066\u305f\u304b\u3089"}
{"start": 239.01999999999998, "end": 268.69, "text": "\u3084\u3063\u305f\u306a\u3044!"}
{"start": 268.69, "end": 269.69, "text": "\u3084\u308b\u304b!"}
{"start": 269.69, "end": 304.61, "text": "\u3053\u306e\u8abf\u5b50!"}
{"start": 304.61, "end": 306.61, "text": "\u3082\u3046\u8ffd\u3063\u3066\u304f\u308c\u306a\u3044\u3060\u308d"}
{"start": 306.61, "end": 308.61, "text": "\u30de\u30b6\u30fc\u30b7\u30c3\u30d7\u306b\u5e30\u9084\u3059\u308b\u305e!"}
{"start": 309.61, "end": 311.61, "text": "\u30d0\u30b0\u306e\u982d\u7f6e\u3044\u3066\u304d\u3061\u3083\u3063\u305f!"}
{"start": 311.61, "end": 313.61, "text": "\u3067\u3082\u623b\u308b\u3068\u307e\u305f\u9762\u5012\u306a\u3053\u3068"}
{"start": 313.61, "end": 315.61, "text": "\u306a\u308a\u305d\u3046\u3060\u3057\u306a"}
{"start": 315.61, "end": 317.61, "text": "\u8ae6\u3081\u308b\u304b"}
{"start": 317.61, "end": 319.61, "text": "\u305b\u3063\u304b\u304f\u306e\u653e\u308a\u51fa\u3057\u8005"}
{"start": 319.61, "end": 322.61, "text": "190\u4e07\u3082\u3057\u305f\u306e\u306b!"}
