[
  {
    "start": 15.18,
    "end": 17.18,
    "text": "馬鹿な奴らだ"
  },
  {
    "start": 17.18,
    "end": 20.18,
    "text": "こんなところで命を無駄にして"
  },
  {
    "start": 20.18,
    "end": 45.77,
    "text": "こいつらもだ"
  },
  {
    "start": 45.77,
    "end": 47.77,
    "text": "己の力も測れずに"
  },
  {
    "start": 47.77,
    "end": 49.77,
    "text": "戦場へ出ると"
  },
  {
    "start": 49.77,
    "end": 51.77,
    "text": "腕!打ち落とせ!"
  },
  {
    "start": 51.77,
    "end": 63.79,
    "text": "神経が凝りつくようだ"
  },
  {
    "start": 63.79,
    "end": 67.23,
    "text": "誰だお前は"
  },
  {
    "start": 67.23,
    "end": 96.56,
    "text": "どこにいる?"
  },
  {
    "start": 96.56,
    "end": 100.1,
    "text": "ターゲットが食いついたよ"
  },
  {
    "start": 101.1,
    "end": 103.1,
    "text": "B2地区に向かってるわ"
  },
  {
    "start": 105.1,
    "end": 109.46,
    "text": "そんじゃ始めるか"
  },
  {
    "start": 109.46,
    "end": 111.46,
    "text": "こっちは準備オーケーだ"
  },
  {
    "start": 111.46,
    "end": 113.46,
    "text": "でも本当に呼びき寄せられるんだろうな"
  },
  {
    "start": 113.46,
    "end": 159.53,
    "text": "来たわね"
  },
  {
    "start": 159.53,
    "end": 160.53,
    "text": "リード"
  },
  {
    "start": 160.53,
    "end": 163.53,
    "text": "やっぱりワイヤートラップには引っかからなかったわ"
  },
  {
    "start": 163.53,
    "end": 164.53,
    "text": "でも大丈夫"
  },
  {
    "start": 164.53,
    "end": 207.3,
    "text": "ターゲットは予定通り通しているわ"
  },
  {
    "start": 207.3,
    "end": 210.3,
    "text": "命を染末するモビルスーツのりは二流だ"
  },
  {
    "start": 210.3,
    "end": 213.3,
    "text": "保留にする価値もない"
  },
  {
    "start": 213.3,
    "end": 214.3,
    "text": "降りろ"
  },
  {
    "start": 214.3,
    "end": 223.12,
    "text": "ミッションコンプリート"
  },
  {
    "start": 223.12,
    "end": 225.12,
    "text": "サーペントテールと知ってで戦おうとするなんて"
  },
  {
    "start": 225.12,
    "end": 227.12,
    "text": "ばっかじゃないの?"
  },
  {
    "start": 227.12,
    "end": 230.12,
    "text": "まあこっちは馬鹿なおかげで珍しい機種を連合に売って"
  },
  {
    "start": 230.12,
    "end": 233.12,
    "text": "たんまりシャレーがもらえるわけだがね"
  },
  {
    "start": 233.12,
    "end": 241.07,
    "text": "ん?あれは?"
  },
  {
    "start": 241.07,
    "end": 243.07,
    "text": "キリサキエド"
  },
  {
    "start": 243.07,
    "end": 245.07,
    "text": "キリサキエド?"
  },
  {
    "start": 245.07,
    "end": 247.07,
    "text": "戦いから戻ったカレノキさんは"
  },
  {
    "start": 247.07,
    "end": 250.07,
    "text": "必ず敵の回避地で濡れていたそうよ"
  },
  {
    "start": 250.07,
    "end": 252.07,
    "text": "ガイより強いの?"
  },
  {
    "start": 252.07,
    "end": 254.07,
    "text": "どうだかな"
  },
  {
    "start": 254.07,
    "end": 262.07,
    "text": "だが脳ギャラで戦うのは絶対に避けたい相手だ"
  },
  {
    "start": 262.07,
    "end": 263.07,
    "text": "ミライジャー"
  },
  {
    "start": 263.07,
    "end": 265.07,
    "text": "輸送戦の声を"
  },
  {
    "start": 265.07,
    "end": 267.07,
    "text": "まずは俺が引き受ける"
  },
  {
    "start": 267.07,
    "end": 269.07,
    "text": "2対1の方がいいんじゃないか"
  },
  {
    "start": 269.07,
    "end": 272.07,
    "text": "船の安全が確保できるまでの戦いだ"
  },
  {
    "start": 272.07,
    "end": 273.07,
    "text": "分かった"
  },
  {
    "start": 273.07,
    "end": 296.39,
    "text": "アドレナリンが沸騰してきたぜ"
  }
]