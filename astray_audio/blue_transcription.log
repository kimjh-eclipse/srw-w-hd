{"start": 15.18, "end": 17.18, "text": "\u99ac\u9e7f\u306a\u5974\u3089\u3060"}
{"start": 17.18, "end": 20.18, "text": "\u3053\u3093\u306a\u3068\u3053\u308d\u3067\u547d\u3092\u7121\u99c4\u306b\u3057\u3066"}
{"start": 20.18, "end": 45.77, "text": "\u3053\u3044\u3064\u3089\u3082\u3060"}
{"start": 45.77, "end": 47.77, "text": "\u5df1\u306e\u529b\u3082\u6e2c\u308c\u305a\u306b"}
{"start": 47.77, "end": 49.77, "text": "\u6226\u5834\u3078\u51fa\u308b\u3068"}
{"start": 49.77, "end": 51.77, "text": "\u8155!\u6253\u3061\u843d\u3068\u305b!"}
{"start": 51.77, "end": 63.79, "text": "\u795e\u7d4c\u304c\u51dd\u308a\u3064\u304f\u3088\u3046\u3060"}
{"start": 63.79, "end": 67.23, "text": "\u8ab0\u3060\u304a\u524d\u306f"}
{"start": 67.23, "end": 96.56, "text": "\u3069\u3053\u306b\u3044\u308b?"}
{"start": 96.56, "end": 100.1, "text": "\u30bf\u30fc\u30b2\u30c3\u30c8\u304c\u98df\u3044\u3064\u3044\u305f\u3088"}
{"start": 101.1, "end": 103.1, "text": "B2\u5730\u533a\u306b\u5411\u304b\u3063\u3066\u308b\u308f"}
{"start": 105.1, "end": 109.46, "text": "\u305d\u3093\u3058\u3083\u59cb\u3081\u308b\u304b"}
{"start": 109.46, "end": 111.46, "text": "\u3053\u3063\u3061\u306f\u6e96\u5099\u30aa\u30fc\u30b1\u30fc\u3060"}
{"start": 111.46, "end": 113.46, "text": "\u3067\u3082\u672c\u5f53\u306b\u547c\u3073\u304d\u5bc4\u305b\u3089\u308c\u308b\u3093\u3060\u308d\u3046\u306a"}
{"start": 113.46, "end": 159.53, "text": "\u6765\u305f\u308f\u306d"}
{"start": 159.53, "end": 160.53, "text": "\u30ea\u30fc\u30c9"}
{"start": 160.53, "end": 163.53, "text": "\u3084\u3063\u3071\u308a\u30ef\u30a4\u30e4\u30fc\u30c8\u30e9\u30c3\u30d7\u306b\u306f\u5f15\u3063\u304b\u304b\u3089\u306a\u304b\u3063\u305f\u308f"}
{"start": 163.53, "end": 164.53, "text": "\u3067\u3082\u5927\u4e08\u592b"}
{"start": 164.53, "end": 207.3, "text": "\u30bf\u30fc\u30b2\u30c3\u30c8\u306f\u4e88\u5b9a\u901a\u308a\u901a\u3057\u3066\u3044\u308b\u308f"}
{"start": 207.3, "end": 210.3, "text": "\u547d\u3092\u67d3\u672b\u3059\u308b\u30e2\u30d3\u30eb\u30b9\u30fc\u30c4\u306e\u308a\u306f\u4e8c\u6d41\u3060"}
{"start": 210.3, "end": 213.3, "text": "\u4fdd\u7559\u306b\u3059\u308b\u4fa1\u5024\u3082\u306a\u3044"}
{"start": 213.3, "end": 214.3, "text": "\u964d\u308a\u308d"}
{"start": 214.3, "end": 223.12, "text": "\u30df\u30c3\u30b7\u30e7\u30f3\u30b3\u30f3\u30d7\u30ea\u30fc\u30c8"}
{"start": 223.12, "end": 225.12, "text": "\u30b5\u30fc\u30da\u30f3\u30c8\u30c6\u30fc\u30eb\u3068\u77e5\u3063\u3066\u3067\u6226\u304a\u3046\u3068\u3059\u308b\u306a\u3093\u3066"}
{"start": 225.12, "end": 227.12, "text": "\u3070\u3063\u304b\u3058\u3083\u306a\u3044\u306e?"}
{"start": 227.12, "end": 230.12, "text": "\u307e\u3042\u3053\u3063\u3061\u306f\u99ac\u9e7f\u306a\u304a\u304b\u3052\u3067\u73cd\u3057\u3044\u6a5f\u7a2e\u3092\u9023\u5408\u306b\u58f2\u3063\u3066"}
{"start": 230.12, "end": 233.12, "text": "\u305f\u3093\u307e\u308a\u30b7\u30e3\u30ec\u30fc\u304c\u3082\u3089\u3048\u308b\u308f\u3051\u3060\u304c\u306d"}
{"start": 233.12, "end": 241.07, "text": "\u3093?\u3042\u308c\u306f?"}
{"start": 241.07, "end": 243.07, "text": "\u30ad\u30ea\u30b5\u30ad\u30a8\u30c9"}
{"start": 243.07, "end": 245.07, "text": "\u30ad\u30ea\u30b5\u30ad\u30a8\u30c9?"}
{"start": 245.07, "end": 247.07, "text": "\u6226\u3044\u304b\u3089\u623b\u3063\u305f\u30ab\u30ec\u30ce\u30ad\u3055\u3093\u306f"}
{"start": 247.07, "end": 250.07, "text": "\u5fc5\u305a\u6575\u306e\u56de\u907f\u5730\u3067\u6fe1\u308c\u3066\u3044\u305f\u305d\u3046\u3088"}
{"start": 250.07, "end": 252.07, "text": "\u30ac\u30a4\u3088\u308a\u5f37\u3044\u306e?"}
{"start": 252.07, "end": 254.07, "text": "\u3069\u3046\u3060\u304b\u306a"}
{"start": 254.07, "end": 262.07, "text": "\u3060\u304c\u8133\u30ae\u30e3\u30e9\u3067\u6226\u3046\u306e\u306f\u7d76\u5bfe\u306b\u907f\u3051\u305f\u3044\u76f8\u624b\u3060"}
{"start": 262.07, "end": 263.07, "text": "\u30df\u30e9\u30a4\u30b8\u30e3\u30fc"}
{"start": 263.07, "end": 265.07, "text": "\u8f38\u9001\u6226\u306e\u58f0\u3092"}
{"start": 265.07, "end": 267.07, "text": "\u307e\u305a\u306f\u4ffa\u304c\u5f15\u304d\u53d7\u3051\u308b"}
{"start": 267.07, "end": 269.07, "text": "2\u5bfe1\u306e\u65b9\u304c\u3044\u3044\u3093\u3058\u3083\u306a\u3044\u304b"}
{"start": 269.07, "end": 272.07, "text": "\u8239\u306e\u5b89\u5168\u304c\u78ba\u4fdd\u3067\u304d\u308b\u307e\u3067\u306e\u6226\u3044\u3060"}
{"start": 272.07, "end": 273.07, "text": "\u5206\u304b\u3063\u305f"}
{"start": 273.07, "end": 296.39, "text": "\u30a2\u30c9\u30ec\u30ca\u30ea\u30f3\u304c\u6cb8\u9a30\u3057\u3066\u304d\u305f\u305c"}
